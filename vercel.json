{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/llms-txt",
      "destination": "/"
    },
    {
      "source": "/ai-robots-txt",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-selfcheck",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/scan.py": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/agent.py": {
      "maxDuration": 40,
      "memory": 1024
    },
    "api/webmcp.js": {
      "maxDuration": 40,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/shot.js": {
      "maxDuration": 45,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/config.js": {
      "maxDuration": 5,
      "memory": 256
    },
    "api/email.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/polar-webhook.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/cron-selfcheck.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/account.js": {
      "maxDuration": 20,
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/ai/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
