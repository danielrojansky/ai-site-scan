{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/llms-txt",
      "destination": "/"
    },
    {
      "source": "/ai-robots-txt",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-selfcheck",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/scan.py": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/agent.py": {
      "maxDuration": 40,
      "memory": 1024
    },
    "api/webmcp.js": {
      "maxDuration": 40,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/shot.js": {
      "maxDuration": 45,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/config.js": {
      "maxDuration": 5,
      "memory": 256
    },
    "api/email.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/polar-webhook.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/cron-selfcheck.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/account.js": {
      "maxDuration": 20,
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=(), serial=(), bluetooth=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://us-assets.i.posthog.com https://eu-assets.i.posthog.com; connect-src 'self' https://rhbhkeuvftqwjjoyzseh.supabase.co wss://rhbhkeuvftqwjjoyzseh.supabase.co https://us.i.posthog.com https://eu.i.posthog.com https://*.google-analytics.com https://*.googleadservices.com https://www.google.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://www.googletagmanager.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/ai/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(logo.png|og-image.png|favicon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
